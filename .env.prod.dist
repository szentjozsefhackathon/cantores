# Default values for production environment. Copy this file to .env.prod on the server and fill in the values.
# Note that on the server these values act as environment variables, so they will override any values set in .env file. 
# Contains database creation credentials as well, so also used in docker-compose - it must be made available using --env-file option in docker-compose command.
APP_NAME=Cantores.hu
APP_URL=https://cantores.hu
APP_DOMAIN=cantores.hu
ASSET_URL=https://cantores.hu
APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_ENV=production
APP_DEBUG=false
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
BROADCAST_CONNECTION=log

DB_CONNECTION=pgsql
DB_HOST=database
DB_DATABASE=cantores
DB_PORT=5432
CACHE_STORE=memcached

FILESYSTEM_DISK=local

LOG_LEVEL=warning
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# Sessions live in Redis, not in Postgres. Every request writes its session
# back, and the two projection polls a second that each running service makes
# turned that into hundreds of row updates a second on one table, purely to move
# last_activity. Redis rather than memcached because it survives its own
# restart: a volatile store would sign every church laptop out mid-Mass.
#
# SESSION_CONNECTION names a connection in config/database.php, and `default`
# keeps sessions on REDIS_DB 0 — away from REDIS_CACHE_DB, so that flushing the
# cache can never take the sessions with it.
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=database
QUEUE_DRIVER=sync

# Octane. The app container no longer boots Laravel per request: it holds a pool
# of workers with the framework already built and hands each request fresh
# application state on top of them.
#
# OCTANE_HTTPS matters more than it looks. Traefik terminates TLS and forwards
# plain HTTP to the container, so without this the worker sees an http request
# and generates http:// links in mail and redirects. trustProxies(at: '*') in
# bootstrap/app.php already reads X-Forwarded-Proto, and this is the belt to that
# braces — a worker that boots before the first request has no request to learn
# the scheme from.
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true

# Both are read by the CMD in Dockerfile.prod and are set here rather than baked
# into the image so the box can be retuned without a rebuild. Left commented
# because the values below are only the starting point Dockerfile.prod falls
# back to when they're absent — 8 workers sized against docker-compose.prod.yml's
# 1024m limit on the app service, not this box's actual memory. Uncomment and
# adjust once you've measured a worker's resident size after an hour warm.
#OCTANE_WORKERS=8
#OCTANE_MAX_REQUESTS=500

# INFO rather than the WARN that LOG_LEVEL uses, and deliberately: Caddy writes
# one JSON line per request at INFO carrying the request's `duration`, which is
# what the Apache CustomLog's %{ms}T was for. Set it to WARN to silence access
# logging entirely.
OCTANE_LOG_LEVEL=INFO

VITE_APP_NAME="${APP_NAME}"

# The following values don't have default settings, must be set in for production environment.
# Admin email address, set in .env, password is not set for production. 
ADMIN_EMAIL=
# Generate with php artisan key:generate --show and set as application secret
APP_KEY=

DB_USERNAME=
DB_PASSWORD=

POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=${DB_DATABASE}

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare Turnstile (CAPTCHA)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The Mercure hub built into FrankenPHP (see docker/frankenphp/Caddyfile), which
# tells a wall and a remote when the show moves so they stop polling every
# second. The same two keys are read by Caddy for the hub and by Laravel to sign
# tokens, so they are set here once. Required: deploy-prod.sh will not deploy
# without them. Generate each with `openssl rand -base64 48`.
#
# The publish URL is the hub as the containers reach it. `app` resolves from
# the app container itself and from the queue beside it, so one value serves
# both.
MERCURE_PUBLISH_URL=http://app:8000/.well-known/mercure
MERCURE_PUBLISHER_JWT_KEY=
MERCURE_SUBSCRIBER_JWT_KEY=
