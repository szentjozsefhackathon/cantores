ARG NODE_VERSION=22-alpine

# Stage 1: Install Composer dependencies (skip scripts to avoid artisan errors)
FROM composer:2 AS composer
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-cache --no-scripts --no-autoloader

# Generate optimized autoloader without running post-autoload-dump scripts
RUN composer dump-autoload --no-dev --optimize --no-scripts

# Stage 2: Build frontend assets (needs vendor for flux.css)
FROM node:${NODE_VERSION} AS node
WORKDIR /app

# Bring in the vendor directory from the composer stage
COPY --from=composer /app/vendor ./vendor

# Install Node dependencies and build
COPY package*.json ./
RUN npm install
COPY resources resources
COPY public public
COPY vite.config.js vite.config.js
RUN npm run build

# Clean up development node_modules (optional)
RUN rm -rf node_modules
RUN npm install --omit=dev

# Stage 3: Final PHP/Apache image
FROM php:8.4-apache AS php
WORKDIR /var/www/html

RUN apt-get update && apt-get upgrade -y && \
    apt-get install --no-install-recommends -y \
    curl

# rsvg-convert + fonts for server-side SVG -> PDF export. Fonts are committed in
# the repo so builds are reproducible offline. rsvg-convert (librsvg) ignores
# @font-face fonts embedded in the SVG and resolves all text through fontconfig,
# so both the lyric text fonts (EB Garamond, Lora, Inter, Barlow Condensed) and
# the abc2svg music notation font must be installed system-wide. The music font
# is referenced as family "music" in abc2svg output; a fontconfig alias maps
# that onto the installed abc2svg.ttf (internal family "abc2svg").
RUN apt-get install -y --no-install-recommends librsvg2-bin fontconfig
COPY resources/fonts/lyric /usr/share/fonts/truetype/cantores
COPY resources/fonts/music/abc2svg.ttf /usr/share/fonts/truetype/cantores/
COPY resources/fonts/music/99-abc2svg-music.conf /etc/fonts/conf.d/
RUN fc-cache -f

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

# Add PHP extensions
COPY --from=mlocati/php-extension-installer:2.7.24 /usr/bin/install-php-extensions /usr/local/bin/
RUN install-php-extensions gd gmp memcached pdo_pgsql pdo_mysql xdebug zip pcntl bcmath intl

# Apache configuration
COPY docker/sites-available/000-default.conf.prod /etc/apache2/sites-available/000-default.conf

# Copy application code
COPY . .

# Run full composer install (with scripts) in the final image
RUN composer install --no-dev --no-interaction --no-cache

# Overlay built assets from node stage
COPY --from=node /app/public/build ./public/build

# Optional: Keep production node_modules if needed for any runtime Node usage
COPY --from=node /app/node_modules ./node_modules

# Set Git commit hash
ARG GIT_COMMIT_HASH
ENV GIT_COMMIT_HASH=${GIT_COMMIT_HASH}
RUN echo "<?php return [ 'hash' => '$GIT_COMMIT_HASH' ];" > config/version.php

# Permissions
RUN chown -R www-data:www-data bootstrap/cache
RUN chown -R www-data:www-data storage

# PHP and Apache settings
RUN cp /usr/local/etc/php/php.ini-production /usr/local/etc/php/php.ini
RUN echo "opcache.jit=tracing" >> /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini \
 && echo "opcache.jit_buffer_size=128M" >> /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini
RUN a2enmod rewrite headers
