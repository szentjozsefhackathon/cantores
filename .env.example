ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secret12345
APP_NAME=Cantores.hu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Octane runs in production and not in local development, where `composer run
# dev` goes on using `artisan serve`: a worker that holds the framework in memory
# is the opposite of what an edit-reload loop wants. To reproduce something that
# only happens under a warm worker — state leaking from one request into the
# next — run `composer run dev:octane`, which serves the same application the
# production image does.
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Where sessions live once a Redis is running beside the application: set
# SESSION_DRIVER=redis and point REDIS_HOST at it (`redis` under either compose
# file). See .env.prod.dist for why the session store is Redis and not the
# database.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile (CAPTCHA)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Anthropic Claude API (for Direktórium PDF processing)
ANTHROPIC_API_KEY=

# szentiras.eu API (for scripture reference lookups)
SZENTIRAS_EU_API_KEY=

# Metadata-only Diatár catalogue sync
DIATAR_REPOSITORY=diatar-eu/diatar-dtxs
DIATAR_REPOSITORY_BRANCH=main
DIATAR_REPOSITORY_TOKEN=
DIATAR_CONNECT_TIMEOUT=5
DIATAR_HTTP_TIMEOUT=20
DIATAR_HTTP_RETRY_ATTEMPTS=3
DIATAR_HTTP_RETRY_DELAY_MS=250
DIATAR_SYNC_DAY=1
DIATAR_SYNC_TIME=03:15
DIATAR_SYNC_ON_ONE_SERVER=true

DEBUGBAR_OPTIONS_MAIL_TIMELINE=false

# The Mercure hub FrankenPHP serves at /.well-known/mercure, which tells a wall
# and a remote when the show moves so they stop polling every second. The keys
# must match the ones docker/frankenphp/Caddyfile.dev hands the hub (these are
# its dev defaults). Leave MERCURE_PUBLISH_URL empty to switch it off: the
# devices then poll as before.
MERCURE_PUBLISH_URL=http://app:8080/.well-known/mercure
MERCURE_PUBLISHER_JWT_KEY=dev-only-mercure-publisher-key-change-me
MERCURE_SUBSCRIBER_JWT_KEY=dev-only-mercure-subscriber-key-change-me
