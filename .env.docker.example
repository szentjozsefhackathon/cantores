XDEBUG_CONFIG="client_host=host.docker.internal"

# GitHub auth for Composer, read natively in every dev service (install + update).
# Avoids the unauthenticated codeload legacy.zip redirect that returns HTTP 400.
# A classic token with no scopes / fine-grained token with public read is enough.
# COMPOSER_AUTH={"github-oauth":{"github.com":"ghp_your_token_here"}}