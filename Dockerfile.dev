ARG FRANKENPHP_VERSION=1-php8.4

# The same base as Dockerfile.prod, and deliberately so. Production moved to
# FrankenPHP when it moved to Octane; leaving dev on php:8.4-apache would have
# kept a second web server, a second vhost format and a second set of static-file
# rules alive for no reason other than that they were already there.
#
# What dev does *not* copy from production is worker mode. The server below is
# started with plain `frankenphp run` against a Caddyfile with no `worker` block,
# so Laravel still boots per request and editing a file still takes effect on
# refresh. See docker/frankenphp/Caddyfile.dev. When an Octane-only bug needs
# reproducing — state surviving between requests is the one that matters — run
# the stack with docker-compose.octane.yml, which swaps this container's command
# for `octane:frankenphp --watch` against the production Caddyfile.
#
# The tag is major-pinned to match production; see Dockerfile.prod on why the ARG
# is declared here at the top rather than inside the stage.
FROM dunglas/frankenphp:${FRANKENPHP_VERSION} AS php
WORKDIR /var/www/html
ARG UID
ARG GID

# Hunspell doesn't work without a proper locale :o
RUN apt-get update && \
    apt-get install -y \
    curl sudo git gh nano python3

# rsvg-convert + fonts for server-side SVG -> PDF export. Fonts are committed in
# the repo so builds are reproducible offline. rsvg-convert (librsvg) ignores
# @font-face fonts embedded in the SVG and resolves all text through fontconfig,
# so both the lyric text fonts (EB Garamond, Alegreya, Merriweather, Inter,
# Barlow Condensed) and the abc2svg music notation font must be
# installed system-wide. The music font is referenced as family "music" in
# abc2svg output; a fontconfig alias maps that onto the installed abc2svg.ttf
# (internal family "abc2svg").
RUN apt-get install -y --no-install-recommends librsvg2-bin fontconfig
COPY resources/fonts/lyric /usr/share/fonts/truetype/cantores
COPY resources/fonts/music/abc2svg.ttf /usr/share/fonts/truetype/cantores/
COPY resources/fonts/music/99-abc2svg-music.conf /etc/fonts/conf.d/
RUN fc-cache -f

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

# Add extensions not included in the base image
COPY --from=mlocati/php-extension-installer:2.7.24 /usr/bin/install-php-extensions /usr/local/bin/
RUN install-php-extensions gd gmp memcached redis pdo_pgsql pdo_mysql xdebug zip pcntl bcmath intl

RUN echo "xdebug.mode=debug,develop,profile" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
    && echo "xdebug.start_with_request=trigger" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
    && echo "xdebug.trigger_value=profile_me" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
    && echo "xdebug.log=/tmp/xdebug.log" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
    && echo "xdebug.output_dir=/tmp/xdebug-profiles" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
    && echo "xdebug.profiler_output_name=cachegrind.out.%p.%t" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
    && mkdir -p /tmp/xdebug-profiles && chmod 777 /tmp/xdebug-profiles

RUN addgroup --gid $GID laravel && \
    adduser --uid $UID --gid $GID --disabled-password --gecos "" laravel && \
    echo 'laravel ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers

RUN chown -R laravel:laravel .

USER laravel

# Put XDG back where XDG says it goes. The FrankenPHP base image points
# XDG_DATA_HOME at /data and XDG_CONFIG_HOME at /config so that Caddy, running as
# root in a single-purpose container, keeps its certificate store somewhere
# predictable. This is not that container: it is a development environment where
# an unprivileged user runs nvm, npm, gh, playwright and the Claude CLI, and
# every one of those reads XDG too. Left alone, they all try to write into two
# root-owned directories that exist for a TLS cache this container never even
# populates — nvm's installer refuses outright, and the rest fail later and less
# clearly. Setting the standard defaults fixes all of them at once, and sends
# Caddy's own state to the laravel user's home along with everything else.
ENV XDG_CONFIG_HOME=/home/laravel/.config
ENV XDG_DATA_HOME=/home/laravel/.local/share

ENV NVM_DIR /home/laravel/.nvm
ENV PATH "/home/laravel/.local/bin:${PATH}"

# The mkdir is not tidiness. nvm's installer refuses to run when NVM_DIR names a
# directory that does not exist *and* does not match the default it would have
# chosen — and its default is "${XDG_CONFIG_HOME}/nvm" whenever XDG_CONFIG_HOME
# is set at all, which on this base image it now is (see the ENV above). Creating
# the directory first settles the question rather than depending on how nvm
# derives a path it is being told explicitly anyway.
RUN mkdir -p $NVM_DIR \
    && curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash \
    && . $NVM_DIR/nvm.sh \
    && nvm install 22 \
    && nvm use 22 \
    && sudo ln -sf "$(nvm which 22)" /usr/local/bin/node \
    && sudo ln -sf "$(dirname "$(nvm which 22)")/npm" /usr/local/bin/npm \
    && sudo ln -sf "$(dirname "$(nvm which 22)")/npx" /usr/local/bin/npx \
    && curl -fsSL https://claude.ai/install.sh | bash

ARG PLAYWRIGHT_VERSION=1.63.0
ENV PLAYWRIGHT_MODULE=/home/laravel/.local/share/playwright/node_modules/playwright
RUN . $NVM_DIR/nvm.sh \
    && npm install --prefix /home/laravel/.local/share/playwright playwright@${PLAYWRIGHT_VERSION} \
    && node ${PLAYWRIGHT_MODULE}/cli.js install --with-deps chromium

# The server. ENTRYPOINT is cleared because the base image's entrypoint launches
# FrankenPHP with its own arguments, and the Caddyfile wanted here is the dev one
# out of the bind-mounted repo rather than the /etc/caddy/Caddyfile that entry
# point expects — keeping it a repo file means the vhost can be edited without a
# rebuild, which is what the Apache one it replaces effectively was too.
#
# --adapter is needed because Caddy picks its config adapter from the file name,
# and `Caddyfile.dev` is not a name it recognises.
#
# Only the `app` service uses this CMD; composer, migrator, queue and the rest
# override it with their own command in docker-compose.yml.
ENTRYPOINT []
CMD ["frankenphp", "run", "--adapter", "caddyfile", "--config", "/var/www/html/docker/frankenphp/Caddyfile.dev"]
